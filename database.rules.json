{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": false,
      ".write": false
    },
    "usernameIndex": {
      ".read": false,
      ".write": false
    },
    "rooms": {
      "$roomCode": {
        ".read": "auth != null && (data.child('status').val() === 'waiting' || data.child('players').child(auth.uid).exists())",
        ".write": false
      }
    }
  }
}
